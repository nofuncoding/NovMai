<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Include="native/vendor/cimai/bindings/CSharp/Cimai/Helper.cs" />
    <Compile Include="native/vendor/cimai/bindings/CSharp/Cimai/Native.cs" />
    <Compile Include="native/vendor/cimai/bindings/CSharp/Cimai/Native.g.cs" />
    <Compile Include="native/vendor/cimai/bindings/CSharp/Cimai/SimaiChart.cs" />
    <Compile Include="native/vendor/cimai/bindings/CSharp/Cimai/SimaiFile.cs" />
  </ItemGroup>
</Project>