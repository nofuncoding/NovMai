<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Remove="src/vendor/" />
    <Compile Remove="src/vendor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cimai" Version="1.1.1" />
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="Lingfeng-bbben.MajSimai" Version="3.0.1" />
    <PackageReference Include="MajProtocol.Standard" Version="2.0.1" />
  </ItemGroup>
</Project>